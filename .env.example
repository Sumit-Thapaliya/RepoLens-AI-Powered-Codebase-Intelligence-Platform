# ---------------------------------------------------------------------------
# RepoLens environment configuration
# Copy to `.env` (repo root) and fill in the values you need.
# NEVER commit real credentials.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- Application
APP_ENV=development                # development | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
# Comma separated. The browser talks to the API through the Next.js proxy by
# default; add your deployed web origin here when running cross-origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------- Database
# Hosted Postgres (Neon) in production:
#   DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.eu-central-1.aws.neon.tech/repolens?sslmode=require
# Local / offline development fallback (SQLite, no pgvector):
#   DATABASE_URL=sqlite:///./data/repolens.db
DATABASE_URL=sqlite:///./data/repolens.db

# Enable the pgvector extension + vector similarity search (Postgres only).
# Automatically forced OFF when DATABASE_URL is not a Postgres URL.
ENABLE_PGVECTOR=true
# Dimension of the embedding vectors. Must match your embedding model.
EMBEDDING_DIM=1536

# ------------------------------------------------------------------- GitHub
# Optional. Raises the REST API rate limit from 60 req/hour (anonymous) to
# 5000 req/hour and enables private repositories you have access to.
GITHUB_TOKEN=

# ----------------------------------------------------------------------- LLM
# LLM_PROVIDER: openai | anthropic | azure-openai | none
# "none" keeps every AI surface working in a grounded, retrieval-only mode
# (answers are extracted from the indexed code with citations).
LLM_PROVIDER=none
LLM_MODEL=                  # e.g. gpt-4o-mini / claude-3-5-sonnet-latest
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

OPENAI_API_KEY=
OPENAI_BASE_URL=            # Azure OpenAI / self-hosted OpenAI-compatible endpoint
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Embeddings
# EMBEDDINGS_PROVIDER: openai | local
# "local" uses a deterministic hashed n-gram model. It is genuinely useful for
# lexical retrieval but is NOT a semantic neural model - the UI labels it.
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=text-embedding-3-small

# ------------------------------------------------------- Analysis guard rails
# A failure in a single file never aborts a repository analysis; these limits
# only bound how much work one run may do.
MAX_FILES=4000                     # files parsed per run
MAX_FILE_BYTES=1048576             # 1 MiB - larger files are skipped (recorded)
MAX_REPO_BYTES=268435456           # 256 MiB - tarball download ceiling
MAX_ANALYSIS_SECONDS=1800          # hard wall-clock budget per run
ANALYSIS_WORKERS=2                 # concurrent background analyses

# ------------------------------------------------------------------ Frontend
# Where the Next.js server proxies /backend/* requests (server-side only).
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE=/backend
