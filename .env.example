# ---------------------------------------------------------------------------
# RepoLens environment configuration
# Copy to `.env` (repo root) and fill in the values you need.
# NEVER commit real credentials.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- Application
APP_ENV=development                # development | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
# Comma separated. The browser talks to the API through the Next.js proxy by
# default; add your deployed web origin here when running cross-origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------- Storage
# Empty (default): results are kept in memory only. Nothing is written to disk,
# and results are cleared when the API restarts. Best for a low-disk machine.
#
# Optional: a hosted Postgres database (for example Neon) keeps results across
# restarts. Use the postgresql+psycopg form:
#   DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.eu-central-1.aws.neon.tech/repolens?sslmode=require
DATABASE_URL=

# Keep only the newest N analyses across all repositories. Re-analysing a
# repository overwrites its previous result, so nothing is kept twice.

# ------------------------------------------------------------------- GitHub
# Optional. Raises the REST API rate limit from 60 req/hour (anonymous) to
# 5000 req/hour and enables private repositories you have access to.
GITHUB_TOKEN=

# ------------------------------------------------------- Analysis guard rails
# A failure in a single file never aborts a repository analysis; these limits
# only bound how much work one run may do.
MAX_FILES=4000                     # files parsed per run
MAX_FILE_BYTES=1048576             # 1 MiB - larger files are skipped (recorded)
MAX_REPO_BYTES=0                   # 0 = no download size limit (the time limit below applies)
MAX_ANALYSIS_SECONDS=1800          # time limit per run (0 = none); the run fails when exceeded
ANALYSIS_WORKERS=2                 # concurrent background analyses

# ------------------------------------------------------------------ Frontend
# Where the Next.js server proxies /backend/* requests (server-side only).
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE=/backend

# Per-window cleanup: a window's analysis is removed this many seconds after its heartbeats stop.
WINDOW_TTL_SECONDS=180
WINDOW_SWEEP_SECONDS=15
