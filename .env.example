# ---------------------------------------------------------------------------
# RepoLens environment configuration
# Copy to `.env` for local development. Never commit real credentials.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- Application
APP_ENV=development                # development | production (production enables Secure session cookies)
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
# Browser-facing API calls normally use the same-origin Next.js proxy.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------- Storage
# Empty (default): analysis records live in an in-memory SQLite database and are
# cleared on API restart. Optional Postgres stores analysis artifacts across
# restarts; persistent rows are still removed by the inactivity cleanup.
# Example: postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL=

# ------------------------------------------------------------------- Sessions
# Anonymous browser sessions are server-issued and stored as SHA-256 digests;
# browsers receive only an HttpOnly cookie. The UI also sends a per-tab id.
SESSION_TTL_SECONDS=2592000         # 30 days, sliding with authenticated activity
WINDOW_TTL_SECONDS=1800             # delete artifacts 30 minutes after tab heartbeats stop
WINDOW_SWEEP_SECONDS=30             # cleanup interval (seconds)

# --------------------------------------------------------------- GitHub access
GITHUB_TOKEN=                       # optional; raises API rate limits
# Private repos are denied by default. Enabling this lets every authenticated
# app session request repositories readable by this single server-side token.
# Only enable for a trusted single-tenant deployment; use per-user OAuth for multi-tenant private repos.
ALLOW_PRIVATE_REPOS=false

# ------------------------------------------------------- Analysis guard rails
MAX_FILES=4000                      # parsed text files per run
MAX_FILE_BYTES=1048576              # skip files larger than 1 MiB
MAX_REPO_BYTES=104857600             # 100 MiB compressed and expanded source cap; 0 disables the cap
MAX_ANALYSIS_SECONDS=1800            # elapsed-time budget checked during downloads and at analysis stage boundaries
ANALYSIS_WORKERS=2                   # concurrent background analyses per API process
MAX_ACTIVE_ANALYSES_PER_SESSION=2
MAX_ANALYSES_PER_HOUR=20

# Full source snippets are not stored by default. The search index keeps only
# deduplicated identifier terms; the code explorer fetches file text from GitHub
# on demand. Enable only for trusted deployments that accept retaining excerpts
# until the analysis inactivity TTL expires.
STORE_SOURCE_SNIPPETS=false

# ------------------------------------------------------------------ Frontend
# Server-side Next.js proxy target. The browser calls /backend/* on the web origin.
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE=/backend
