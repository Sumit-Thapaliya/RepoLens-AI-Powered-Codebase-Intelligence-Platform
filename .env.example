# ---------------------------------------------------------------------------
# RepoLens configuration
# Copy to `.env` for local development. GITHUB_TOKEN is optional; no database URL is used.
# ---------------------------------------------------------------------------

APP_ENV=development                # development | production (production enables Secure session cookies)
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Anonymous browser sessions; analysis results stay in RAM and expire after inactivity.
SESSION_TTL_SECONDS=2592000         # 30 days
WINDOW_TTL_SECONDS=1800             # expire ~30 minutes after the last heartbeat (active input refreshes it)
WINDOW_SWEEP_SECONDS=30             # cleanup interval (seconds)

# Public GitHub repositories only. Anonymous REST API limit is approximately 60 requests/hour per source IP.
# Optional server-side token: a GitHub PAT with no scopes can access public data and typically raises
# the authenticated limit to up to 5,000 requests/hour per user. Never expose this in browser code.
# GITHUB_TOKEN=

# Analysis guard rails
MAX_FILES=4000                      # parsed text files per run
MAX_FILE_BYTES=1048576              # skip files larger than 1 MiB
MAX_REPO_BYTES=104857600             # 100 MiB compressed and expanded source cap; 0 disables the cap
MAX_ANALYSIS_SECONDS=1800            # deadline checked during downloads and between analysis stages
ANALYSIS_WORKERS=2                   # concurrent background analyses per API process
MAX_ACTIVE_ANALYSES_PER_SESSION=2
MAX_ANALYSES_PER_HOUR=20

# By default, search stores identifier terms rather than source excerpts.
# Enable only if retaining bounded excerpts in RAM until expiry is acceptable.
STORE_SOURCE_SNIPPETS=false

# Server-side Next.js proxy target; the browser calls /backend/* on the web origin.
API_INTERNAL_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE=/backend
